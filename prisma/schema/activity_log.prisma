model ActivityLog {
  logId      Int      @id @default(autoincrement()) @map("log_id")
  userId     Int      @map("user_id")
  tenderId   Int?     @map("tender_id")
  bidId      Int?     @map("bid_id")
  actionType String   @map("action_type") // CREATE / UPDATE / DELETE ...
  entityType String   @map("entity_type") // TENDER / BID / USER / ORGANIZATION
  entityId   Int?     @map("entity_id")
  oldValues  String?  @map("old_values") @db.Text
  newValues  String?  @map("new_values") @db.Text
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user   User    @relation(fields: [userId], references: [id])
  tender Tender? @relation(fields: [tenderId], references: [id])
  bid    Bid?    @relation(fields: [bidId], references: [id])

  @@map("ACTIVITY_LOG")
}
