model BidStatus {
  id           Int     @id @default(autoincrement()) @db.UnsignedTinyInt
  statusName   String  @map("status_name")
  statusNameAr String  @map("status_name_ar")
  isFinal      Boolean @default(false) @map("is_final")
  reason       String? @db.Text

  // Relations
  bids             Bid[]
  oldStatusHistory BidStatusHistory[] @relation("BidOldStatus")
  newStatusHistory BidStatusHistory[] @relation("BidNewStatus")

  @@map("BID_STATUS")
}
