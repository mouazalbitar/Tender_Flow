model BidStatusHistory {
  id          Int      @id @default(autoincrement())
  bidId       Int      @map("bid_id")
  oldStatusId Int      @map("old_status_id") @db.UnsignedTinyInt
  newStatusId Int      @map("new_status_id") @db.UnsignedTinyInt
  changedBy   Int      @map("changed_by")
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  bid       Bid       @relation(fields: [bidId], references: [id])
  oldStatus BidStatus @relation("BidOldStatus", fields: [oldStatusId], references: [id])
  newStatus BidStatus @relation("BidNewStatus", fields: [newStatusId], references: [id])
  user      User      @relation(fields: [changedBy], references: [id])

  @@map("BID_STATUS_HISTORY")
}
