model Contract {
  contractId     Int       @id @default(autoincrement()) @map("contract_id")
  tenderId       Int       @map("tender_id")
  bidId          Int       @map("bid_id")
  contractNumber String    @unique @map("contract_number")
  contractValue  Decimal   @map("contract_value") @db.Decimal(15, 2)
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  status         String    @default("DRAFT") // DRAFT / ACTIVE / COMPLETED / TERMINATED
  attachmentUrl  String?   @map("attachment_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Relations
  tender Tender @relation(fields: [tenderId], references: [id])
  bid    Bid    @relation(fields: [bidId], references: [id])

  @@map("CONTRACT")
}
