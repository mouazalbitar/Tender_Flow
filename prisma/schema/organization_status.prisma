model OrganizationStatus {
  id           Int    @id @default(autoincrement()) @db.UnsignedTinyInt
  statusName   String @map("status_name")
  statusNameAr String @map("status_name_ar")
  description  String

  organizations    Organization[]
  statusHistoryOld OrganizationStatusHistory[] @relation("OldStatus")
  statusHistoryNew OrganizationStatusHistory[] @relation("NewStatus")

  @@map("ORGANIZATION_STATUS")
}
