model OrganizationStatusHistory {
  id          Int     @id @default(autoincrement())
  orgId       Int     @map("org_id")
  oldStatusId Int     @map("old_status_id") @db.UnsignedTinyInt
  newStatusId Int     @map("new_status_id") @db.UnsignedTinyInt
  changedBy   Int     @map("changed_by")
  reason      String?

  org       Organization       @relation(fields: [orgId], references: [id])
  oldStatus OrganizationStatus @relation("OldStatus", fields: [oldStatusId], references: [id])
  newStatus OrganizationStatus @relation("NewStatus", fields: [newStatusId], references: [id])
  changer   User               @relation(fields: [changedBy], references: [id])

  @@map("ORGANIZATION_STATUS_HISTORY")
}
