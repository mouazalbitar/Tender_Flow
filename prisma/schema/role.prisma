model Role {
  id          Int     @id @default(autoincrement())
  orgTypeId   Int     @map("org_type_id") @db.UnsignedTinyInt
  roleName    String  @map("role_name")
  roleNameAr  String  @map("role_name_ar")
  description String?

  orgType         OrganizationType @relation(fields: [orgTypeId], references: [id])
  users           User[]
  rolePermissions RolePermission[]

  @@map("ROLE")
}
