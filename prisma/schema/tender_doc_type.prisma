model TenderDocType {
  id          Int     @id @default(autoincrement())
  typeName    String  @map("type_name")
  typeNameAr  String  @map("type_name_ar")
  isRequired  Boolean @default(false) @map("is_required")
  description String? @db.Text

  // Relations
  tenderDocuments TenderDocument[]

  @@map("TENDER_DOC_TYPE")
}
